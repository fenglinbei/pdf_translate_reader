# Copy to .env.qa.local; this service NEVER loads .env or .env.local.
# Development/staging must use a separate Supabase project and test accounts.
QA_ENVIRONMENT=development
QA_PORT=8788
QA_INDEX_WORKER_ENABLED=false
# Apply the document-tools and 20260925_qa_workspace migrations to the isolated DB first.
# Workspace rollback also needs the thread-origin procedure in docs/qa-workspace-agent-plan.md.
QA_AGENT_RUNTIME=workspace-tools-v1
# Optional versioned reading/citations: apply 20260925_qa_document_artifacts.sql
# and 20260925_qa_artifact_answers.sql first, then set runtime to workspace-artifacts-v1.
# The frontend discovers document preparation through authenticated capabilities.
QA_DOCUMENT_ARTIFACTS_ENABLED=false
QA_MAX_CONCURRENT_STREAMS=2
# workspace-artifacts-v1 defaults to 8 queued requests; older runtimes default to 0.
# QA_MAX_QUEUED_STREAMS=8
QA_QUEUE_WAIT_MS=120000
QA_DOCUMENT_MODELS=deepseek-flash,deepseek-v4-pro
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
# VOYAGE_API_KEY is only needed for legacy indexing/retrieval.
# Optional server-only migration connection to the SAME isolated test database.
# Never prefix this with VITE_ or commit .env.qa.local.
# QA_TEST_DATABASE_URL=
# Provider configuration uses the existing server/models adapters.
# In the stable main service, QA_EMBEDDED_ENABLED=false disables its QA routes
# and index recovery after the independent QA service has been accepted.

# The same file can drive the dev frontend: run it as `vite --mode qa` and Vite
# loads .env.qa.local on top of .env.local. Uncomment these only for that mode;
# they are ignored by server/qa-service.mjs.
# A mismatched pair is the usual cause of 401s - the frontend signs in against
# VITE_SUPABASE_URL while the QA service validates the token against SUPABASE_URL.
# server/supabase/config.mjs accepts either name, so keep them on one project.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_QA_API_PROXY_TARGET=http://127.0.0.1:8789
# Point /api/ at a main-app instance that uses the SAME test project, otherwise
# translation and library calls 401 once the frontend logs into the test project.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8790
