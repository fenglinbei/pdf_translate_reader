{
  "name": "pdf-translate-reader",
  "version": "0.3.0-alpha.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "dev:qa": "node server/qa-service.mjs",
    "demo:qa": "node scripts/demo-qa-agent.mjs",
    "demo:qa-document": "node scripts/demo-document-agent.mjs",
    "demo:qa-artifacts": "node scripts/demo-document-artifacts.mjs",
    "test": "node --test tests/*/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:qa-env": "node scripts/check-qa-env.mjs",
    "check:agent-equivalence": "node scripts/check-agent-equivalence.mjs",
    "ci": "npm run check:release && npm test && npm run build",
    "package:qa": "node scripts/package-qa.mjs",
    "build": "tsc --noEmit && vite build",
    "deploy:linux:nginx": "bash scripts/deploy-linux-nginx.sh",
    "preview": "vite preview --host 0.0.0.0",
    "test:mathpix": "node --test tests/mathpix/*.test.mjs",
    "test:library": "node --test tests/library/*.test.mjs",
    "test:qa": "node --test tests/qa/*.test.mjs",
    "test:translation": "node --test tests/translation/*.test.mjs",
    "test:models": "node --test tests/models/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.8",
    "ajv": "8.20.0",
    "dotenv": "16.4.7",
    "idb": "8.0.0",
    "katex": "^0.17.0",
    "lucide-react": "0.468.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.60.0",
    "typescript": "5.7.2",
    "vite": "5.4.21"
  }
}
