# Copy only into the dedicated production service directory, owned root:pdf-reader-qa 0640.
# Fill provider and Supabase values from the existing production configuration.
# Never use the QA test project's credentials here. No database password is needed by this service.
QA_ENVIRONMENT=production
QA_PORT=8788
QA_AGENT_RUNTIME=workspace-artifacts-v1
QA_DOCUMENT_ARTIFACTS_ENABLED=true
QA_INDEX_WORKER_ENABLED=false
QA_DOCUMENT_MODELS=deepseek-flash,deepseek-v4-pro
QA_MAX_CONCURRENT_STREAMS=2
QA_MAX_QUEUED_STREAMS=8
QA_QUEUE_WAIT_MS=120000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
# Preserve the existing DEEPSEEK_BASE_URL / model-provider overrides if configured.
