DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
ALIYUN_API_KEY=replace_with_your_aliyun_api_key
# Set the OpenAI-compatible Base URL shown for your Alibaba Cloud region/workspace.
# ALIYUN_API_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY and QWEN_API_BASE_URL are accepted aliases.
QWEN_TRANSLATION_MAX_TOKENS=16384
GLM_API_KEY=replace_with_your_glm_api_key
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TRANSLATION_MAX_TOKENS=16384
KIMI_API_KEY=replace_with_your_kimi_api_key
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_TRANSLATION_MAX_COMPLETION_TOKENS=16384
# QA default is awaiting sample evaluation; retain the existing default for now.
# QA_DEFAULT_CHAT_MODEL=deepseek-v4-pro
# Per-provider *_QA_MODEL overrides are no longer used; select an exact catalog ID.
PORT=8787
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key
MATHPIX_APP_ID=your_app_id
MATHPIX_APP_KEY=your_app_key
MATHPIX_DELETE_REMOTE_AFTER_CACHE=true
MATHPIX_MAX_PDF_BYTES=104857600
MATHPIX_API_BASE_URL=https://api.mathpix.com
